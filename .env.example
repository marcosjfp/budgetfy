# Copy to .env.local and fill in. Never commit real secrets (.env* is git-ignored).

# --- Runtime -----------------------------------------------------------------
# "production" enables strict checks: the server refuses to start with a missing/weak
# JWT_SECRET or a missing FIREBASE_PROJECT_ID, and drop.ts refuses to run.
NODE_ENV=development
# Port for the Express API (Vite proxies /api to it in dev).
PORT=3001

# --- Database (required) -----------------------------------------------------
DATABASE_URL=postgresql://budgetfy:change_me@localhost:5432/budgetfy

# --- Auth (required in production) ------------------------------------------
# HMAC secret for Budgetfy's own email/password JWTs. At least 32 random characters.
# Generate one with:  openssl rand -base64 48
# If unset in development, an ephemeral random secret is used (sessions reset on restart).
JWT_SECRET=
# Token lifetime: seconds, or a number with s/m/h/d suffix. Default 7d.
JWT_EXPIRES_IN=7d
# bcrypt cost factor for password hashing (10-15). Default 12.
BCRYPT_ROUNDS=12

# Firebase project whose ID tokens (Google sign-in) are accepted. Required in production.
# In development it falls back to projectId in firebase-applet-config.json.
FIREBASE_PROJECT_ID=

# --- HTTP / CORS -------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API cross-origin.
# "*" is rejected. If empty: APP_URL's origin is used; otherwise http://localhost:3000 in
# development and same-origin only in production.
CORS_ORIGINS=
# Express "trust proxy" setting so rate limiting sees real client IPs behind a proxy/load
# balancer. Use the number of proxy hops (e.g. 1 on Cloud Run), "true", or a subnet list.
# Leave empty/false when the API is reached directly.
TRUST_PROXY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Dangerous scripts --------------------------------------------------------
# drop.ts only targets localhost unless this is "true". Never set it in production.
ALLOW_REMOTE_DROP=false
